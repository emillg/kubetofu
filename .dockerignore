# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source directories. Parent directories must be re-included
# explicitly, otherwise their contents stay excluded.
!cmd
!cmd/**
!internal
!internal/**
!api
!api/**

# Re-include Go module files
!go.mod
!go.sum

# Re-include runner image files (used by the tofu-runner build)
!runner
!runner/**

# Exclude Go test files
**/*_test.go
